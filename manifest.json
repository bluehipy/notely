{
  "manifest_version": 3,
  "name": "Notely",
  "version": "1.0.0",
  "description": "Friendly note and list manager",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Notely",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "nativeMessaging", "identity"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "http://127.0.0.1:3779/*"
  ],
  "oauth2": {
    "client_id": "355584706166-24icp2so00pi5dhjoc3vsn78s50cop5p.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["js/*", "css/*", "index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
